def makeAntioboticConcentrations(ratio):
    # Create a FRESH array for this specific worker, rather than editing a global one
    local_antibiotic = 1e-2 * np.ones((N_x, N_y), dtype=np.float64)
    local_thresholds = np.empty(steps, dtype=np.int32)
    
    for i in range(1, steps):
        prevConcentration = baseConcentration * (i - 1) + 1e-2
        targetConcentration = baseConcentration * i + 1e-2

        interConcentration = prevConcentration + (targetConcentration - prevConcentration) * ratio
        local_antibiotic[:, i * N_y // steps - transitionWidth:] = interConcentration
        local_antibiotic[:, i * N_y // steps:] = targetConcentration

        local_thresholds[i] = int(.5 * (i * N_y // steps - transitionWidth + (i + 1) * N_y // steps))
        
    return local_antibiotic, local_thresholds

