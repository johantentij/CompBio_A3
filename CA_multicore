        #         bacteria[newX, newY] = True
        #         bacteria_indices[i] = [newX, newY]

        i += 1

    return aliveCount, genomeCounter       

max_iterations = int(2e5) 

def simulate_ratio(ratio):
    print(f"Starting simulation for ratio: {ratio}")
    
    # 1. Initialize LOCAL state for this specific process
    local_nutrients = initNutrient * np.ones((N_x, N_y), dtype=np.float64)
    local_antibiotic, local_thresholds = makeAntioboticConcentrations(ratio)
    
    local_bacteria_indices = np.empty((N_x * N_y, 2), dtype=np.int32)
    local_bacteria_indices[0] = [N_x // 2, 0]
    local_aliveCount = 1

    local_bacteria = np.zeros((N_x, N_y), dtype=np.bool_)
    local_bacteria[local_bacteria_indices[0, 0], local_bacteria_indices[0, 1]] = True
    
    local_K_antibiotic = np.empty(N_x * N_y, dtype=np.float64) 
    local_K_antibiotic[0] = 5

    local_genomeIDs = np.empty((N_x * N_y, 4), dtype=np.int32)
    local_genomeCounter = 0
    local_genomeIDs[0, :] = [local_genomeCounter, local_genomeCounter, local_bacteria_indices[0, 0], local_bacteria_indices[0, 1]]

    threshold_times = np.empty(steps)
    threshold_times[:] = np.nan
    furthest = 0

    # 2. Run the simulation loop
    for i in range(max_iterations):
        # diffuse nutrients
        local_nutrients = updateNutrients(local_nutrients)

        # dinner time
        local_nutrients[local_bacteria] -= nutrientConsumption

        # increment CA
        local_aliveCount, local_genomeCounter = bacteriaStep(
            local_nutrients, 
            local_bacteria, local_bacteria_indices, 
            local_antibiotic, local_K_antibiotic, 
            local_aliveCount, 
            local_genomeIDs, local_genomeCounter
        )

        # Check thresholds
        if (np.sum(local_bacteria[:, local_thresholds[furthest]:]) > 0):
            threshold_times[furthest] = i
            furthest += 1
            print(f"Ratio {ratio:.2f}: Reached zone {furthest}/{steps} at step {i}")

        if (furthest >= steps):
            print("succesful ending")
            break

    # 3. Process and return results
    interTimes = np.diff(threshold_times)
    interTimes = interTimes[~np.isnan(interTimes)] 
    
    if len(interTimes) > 0:
        return 1 / np.mean(interTimes)
    else:
        return np.nan # Handle cases where it never crossed a threshold
    

# The if __name__ == '__main__': block is still highly recommended 
# to prevent recursive spawning on Windows and macOS.
if __name__ == '__main__':
    ratios = [.2, .3, .4, .5, .6, .7]
    
    print("Starting parallel simulation using joblib...")
    t0 = time.time()
    
    # n_jobs=-1 tells joblib to use ALL available CPU cores.
    # delayed() wraps your function so it can be distributed to the workers.
    meanTimes = Parallel(n_jobs=-1)(delayed(simulate_ratio)(ratio) for ratio in ratios)
        
    print(f"Total time taken: {time.time() - t0:.2f} seconds")

    # Plot results
    plt.plot(ratios, meanTimes, marker='o')
    plt.xlabel("Intermediate concentration ratio")
    plt.ylabel("1 / mean adaptation time")
    plt.grid(True)
    plt.show()